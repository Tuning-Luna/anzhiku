# 运行环境
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=anzhiku

# 文件存储
UPLOAD_DIR=./storage/files
MAX_FILE_SIZE_MB=50
URL_MAX_SIZE_MB=50
URL_DOWNLOAD_TIMEOUT_MS=30000

# 阿里云百炼 (DashScope, OpenAI 兼容)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-doc-turbo
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=300000

# 解析任务
JOB_CONCURRENCY=1

# 日志
LOG_LEVEL=info
